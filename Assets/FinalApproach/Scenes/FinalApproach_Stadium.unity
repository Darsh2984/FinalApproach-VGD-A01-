  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "OBJECTIVE\r\nThrow the javelin as far as possible without crossing the foul line.\r\nYou have 3 attempts. Your longest valid throw is your round score.\r\n\r\nCONTROLS\r\nSPACE \u2014 Tap rhythmically to build running speed.\r\nLEFT SHIFT \u2014 Hold to prepare; release to throw.\r\nW / S \u2014 Adjust the throwing angle while holding Shift.\r\nENTER \u2014 Continue after each throw.\r\nH \u2014 Open or close How to Play during an attempt.\r\n\r\nTIPS\r\nBuild speed with steady Space taps.\r\nRelease close to the line for a stronger throw.\r\nCrossing the line before release is a foul.\r\nExperiment with different throwing angles."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
